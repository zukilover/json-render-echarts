{
  "name": "@json-render-echarts/registry",
  "version": "1.0.1",
  "description": "React registry for ECharts components",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs --dts --target es2018",
    "dev": "tsup src/index.tsx --format cjs --watch --dts",
    "lint": "eslint src/**/*.tsx"
  },
  "dependencies": {
    "@json-render/core": "^0.3.0",
    "@json-render/react": "^0.2.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@json-render/core": "^0.3.0",
    "@json-render/react": "^0.2.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
